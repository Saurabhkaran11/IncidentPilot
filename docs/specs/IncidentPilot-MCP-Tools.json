{
  "tools": [
    {
      "name": "get_incident_context",
      "description": "Read the incident and trusted application registration for this bound run. Includes intended resource and deployment-policy references; these are not exhaustive live IAM analysis. No execution or approval authority is returned.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "incident_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "incident_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "error"
            ]
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "incident_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "app_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "demo_run_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "state": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "fixture",
                      "aws_live"
                    ]
                  },
                  "first_failure_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "expected_results_table_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "deployment_manifest_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allowed_runbook_id": {
                    "const": "document-alias-rollback-v1"
                  },
                  "failed_request_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                  },
                  "policy_context": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "deployment_manifest"
                      },
                      "processor_role_fingerprint": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "allowed_results_table_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "observed_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "source",
                      "processor_role_fingerprint",
                      "allowed_results_table_ref",
                      "observed_at"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "incident_id",
                  "app_id",
                  "demo_run_id",
                  "state",
                  "mode",
                  "first_failure_at",
                  "expected_results_table_ref",
                  "deployment_manifest_ref",
                  "allowed_runbook_id",
                  "failed_request_count",
                  "policy_context"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "source_type": {
                  "enum": [
                    "cloudwatch_log",
                    "lambda_configuration",
                    "deployment_manifest",
                    "request_inbox",
                    "runbook"
                  ]
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Server-resolved source locator within the registered application."
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "summary": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "evidence_id",
                "source_type",
                "source_ref",
                "observed_at",
                "retrieved_at",
                "payload_sha256",
                "summary"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "truncated": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            },
            "maxItems": 20
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "RESOURCE_OUT_OF_SCOPE",
                      "EVIDENCE_UNAVAILABLE",
                      "RATE_LIMITED",
                      "TIMEOUT",
                      "INVALID_ARGUMENT",
                      "INTERNAL_ERROR"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "retryable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "schema_version",
          "status",
          "data",
          "evidence",
          "truncated",
          "warnings",
          "error"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "error"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "null"
                },
                "error": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "data": {
                  "type": "object"
                },
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
