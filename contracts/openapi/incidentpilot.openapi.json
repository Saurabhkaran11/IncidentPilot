  "info": {
    "description": "Investigate a failed AWS request-processing workflow, approve a bounded Lambda alias rollback, and verify recovery.",
    "title": "IncidentPilot control API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Process readiness only -- no configuration details, no auth.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
